# Copie para .env.local. Nunca use prefixo VITE_ para segredos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
INOVA_AI_ENABLED=true

# Integração PostgreSQL/Supabase (somente servidor; nunca use VITE_).
# Mantenha false até criar o projeto e aplicar as migrações.
INOVA_DATABASE_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
